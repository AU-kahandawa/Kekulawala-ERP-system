rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ERP Enterprise Collections: Read and write permissions
    // Allows seamless local and remote operations across Kekulawala ERP workstations
    match /clients/{document=**} {
      allow read, write: if true;
    }
    match /projects/{document=**} {
      allow read, write: if true;
    }
    match /materials/{document=**} {
      allow read, write: if true;
    }
    match /tools/{document=**} {
      allow read, write: if true;
    }
    match /suppliers/{document=**} {
      allow read, write: if true;
    }
    match /employees/{document=**} {
      allow read, write: if true;
    }
    match /quotations/{document=**} {
      allow read, write: if true;
    }
    match /letters/{document=**} {
      allow read, write: if true;
    }
    match /transactions/{document=**} {
      allow read, write: if true;
    }
    match /orders/{document=**} {
      allow read, write: if true;
    }
    match /transports/{document=**} {
      allow read, write: if true;
    }
    match /attendance/{document=**} {
      allow read, write: if true;
    }
    match /payroll/{document=**} {
      allow read, write: if true;
    }
    match /settings/{document=**} {
      allow read, write: if true;
    }
    match /legal/{document=**} {
      allow read, write: if true;
    }
    match /_test_connectivity/{document=**} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
